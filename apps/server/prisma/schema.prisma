generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  pending
  accepted
  preparing
  ready
  completed
  cancelled
}

enum PaymentMethod {
  gcash
  bank_transfer
  cash_on_pickup
}

enum PaymentStatus {
  unpaid
  instructions_sent
  reference_submitted
  confirmed
}

enum InventoryMovementType {
  purchase
  adjustment
  sale
  reversal
}

model Merchant {
  id                 String              @id @default(cuid())
  name               String
  slug               String              @unique
  tagline            String?             @db.Text
  pickupInstructions String?             @db.Text
  gcashAccountName   String?
  gcashNumber        String?
  bankName           String?
  bankAccountName    String?
  bankAccountNumber  String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  users              MerchantUser[]
  sessions           MerchantSession[]
  categories         ProductCategory[]
  products           Product[]
  inventoryItems     InventoryItem[]
  inventoryMovements InventoryMovement[]
  pickupSlots        PickupSlot[]
  orders             Order[]
}

model MerchantUser {
  id                 String              @id @default(cuid())
  merchantId         String
  name               String
  email              String              @unique
  role               String              @default("merchant")
  passwordHash       String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  merchant           Merchant            @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  sessions           MerchantSession[]
  inventoryMovements InventoryMovement[]
}

model MerchantSession {
  id         String       @id @default(cuid())
  merchantId String
  userId     String
  tokenHash  String       @unique
  expiresAt  DateTime
  createdAt  DateTime     @default(now())
  merchant   Merchant     @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  user       MerchantUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model ProductCategory {
  id         String    @id @default(cuid())
  merchantId String
  name       String
  sortOrder  Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  merchant   Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  products   Product[]
}

model Product {
  id                    String                        @id @default(cuid())
  merchantId            String
  categoryId            String
  name                  String
  description           String?                       @db.Text
  priceCents            Int
  imageUrl              String?                       @db.VarChar(500)
  isActive              Boolean                       @default(true)
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt
  merchant              Merchant                      @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  category              ProductCategory               @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  orderItems            OrderItem[]
  inventoryRequirements ProductInventoryRequirement[]
}

model InventoryItem {
  id             String                        @id @default(cuid())
  merchantId     String
  name           String
  unit           String
  quantityOnHand Decimal                       @default(0) @db.Decimal(14, 3)
  reorderLevel   Decimal                       @default(0) @db.Decimal(14, 3)
  unitCostCents  Decimal                       @default(0) @db.Decimal(14, 4)
  isActive       Boolean                       @default(true)
  createdAt      DateTime                      @default(now())
  updatedAt      DateTime                      @updatedAt
  merchant       Merchant                      @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  requirements   ProductInventoryRequirement[]
  movements      InventoryMovement[]

  @@unique([merchantId, name])
}

model ProductInventoryRequirement {
  id              String        @id @default(cuid())
  productId       String
  inventoryItemId String
  quantity        Decimal       @db.Decimal(14, 3)
  product         Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@unique([productId, inventoryItemId])
}

model InventoryMovement {
  id              String                @id @default(cuid())
  merchantId      String
  inventoryItemId String
  orderId         String?
  createdById     String?
  type            InventoryMovementType
  quantityChange  Decimal               @db.Decimal(14, 3)
  unitCostCents   Decimal?              @db.Decimal(14, 4)
  note            String?               @db.Text
  createdAt       DateTime              @default(now())
  merchant        Merchant              @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  inventoryItem   InventoryItem         @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  order           Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdBy       MerchantUser?         @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([inventoryItemId, createdAt])
  @@index([orderId])
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
}

model PickupSlot {
  id         String   @id @default(cuid())
  merchantId String
  label      String
  startTime  DateTime
  endTime    DateTime
  capacity   Int      @default(8)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  orders     Order[]
}

model Order {
  id                  String              @id @default(cuid())
  orderNumber         String              @unique
  merchantId          String
  customerId          String
  pickupSlotId        String?
  status              OrderStatus         @default(pending)
  paymentMethod       PaymentMethod
  paymentStatus       PaymentStatus       @default(instructions_sent)
  paymentReference    String?
  subtotalCents       Int
  totalCents          Int
  customerNote        String?             @db.Text
  completedAt         DateTime?
  inventoryDeductedAt DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  merchant            Merchant            @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  customer            Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  pickupSlot          PickupSlot?         @relation(fields: [pickupSlotId], references: [id], onDelete: SetNull)
  items               OrderItem[]
  statusEvents        OrderStatusEvent[]
  inventoryMovements  InventoryMovement[]
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  productId      String
  productName    String
  quantity       Int
  unitPriceCents Int
  lineTotalCents Int
  totalCostCents Int?
  createdAt      DateTime @default(now())
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
}

model OrderStatusEvent {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  note      String?     @db.Text
  createdAt DateTime    @default(now())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
}
